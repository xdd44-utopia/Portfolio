        { href: '/css/404.css' },
        { href: '/css/404_mobile.css', media: 'screen and (max-width: 450px)' },
    ]}
>
    <div id="Main">
        <div class="error-container">
            <p class="error-code">404</p>
            <p class="error-message">This page could not be found.</p>
            <a href="/" class="error-link">Return home</a>
        </div>
    </div>
</SiteLayout>
