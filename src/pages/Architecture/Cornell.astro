---
import ProjectLayout from '../../layouts/ProjectLayout.astro';

const page = {
    "title": "A study in windows | xdd44's Collections",
    "description": "A design exploration from Cornell AAP Summer Program investigating the architectural language of windows and their spatial and compositional implications.",
    "image": "https://xdd44.xyz/image/Architecture/Cornell/Final.jpg",
    "heading": "A study in windows",
    "cover": "image/Architecture/Cornell/Final.jpg",
    "category": "Architecture",
    "year": "2021",
    "tags": [
