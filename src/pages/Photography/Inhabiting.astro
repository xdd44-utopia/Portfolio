---
import PhotographyLayout from '../../layouts/PhotographyLayout.astro';

const photos = [
    "/image/Photography/Inhabiting/0.jpg",
    "/image/Photography/Inhabiting/1.jpg",
    "/image/Photography/Inhabiting/2.jpg",
    "/image/Photography/Inhabiting/3.jpg",
    "/image/Photography/Inhabiting/4.jpg",
    "/image/Photography/Inhabiting/5.jpg",
    "/image/Photography/Inhabiting/6.jpg",
    "/image/Photography/Inhabiting/7.jpg",
    "/image/Photography/Inhabiting/8.jpg",
    "/image/Photography/Inhabiting/9.jpg"
];
---

<PhotographyLayout
    title={"Inhabiting"}
    subtitle={"Photography | Hong Kong"}
    ogDescription={"A Hong Kong photography series exploring how people inhabit and situate themselves within the city's large architectural structures."}
    image={"https://xdd44.xyz/image/Photography/Inhabiting/0.jpg"}
>
    <div class="container">
        <p style="padding-top: 20vh;">
            Although those <a href="/Photography/Automonument">Automonuments</a> have domunated Hong Kong, I think humanity is a major part of urbanization which we should concern. Thus, through this collection of seemingly ordinary scenes, I tried to capture
            how we human place ourself in, or inhabit such large structures.
        </p>
    </div>
    {photos.map(src => (
        <div class="container">
            <img src={src} />
        </div>
    ))}
</PhotographyLayout>
