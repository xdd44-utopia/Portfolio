---
import ProjectLayout from '../../layouts/ProjectLayout.astro';

const page = {
    "title": "Logo | xdd44's Collections",
    "description": "The evolution and variants of xdd44's personal logo across multiple generations of design.",
    "image": "https://xdd44.xyz/image/Home_BKG.jpg",
    "heading": "Logo",
    "cover": "image/Art/Logo/logo-image.jpg",
    "category": "Art & Design",
    "year": "2014–",
    "tags": [
        "Personal Identity",
        "Logo Design",
        "Graphic Design"
    ]
};
---

<ProjectLayout {...page}>
    <p>The generations and variants of my logo.</p>
    <figure class="project-figure wide"><img src="image/Art/Logo/logo-scratch.png" alt="..."></figure>
    <figure class="project-figure wide"><img src="image/Art/Logo/logo 1.png" alt="..."></figure>
    <figure class="project-figure wide"><img src="image/Art/Logo/logo 2.png" alt="..."></figure>
    <figure class="project-figure wide"><img src="image/Art/Logo/logo 3.0.1.png" alt="..."></figure>
    <figure class="project-figure wide"><img src="image/logo 3.0.1.jpg" alt="..."></figure>
    <figure class="project-figure wide"><img src="image/Art/Logo/logo 3_1.jpg" alt="..."></figure>
    <figure class="project-figure wide"><img src="image/Art/Logo/logo 3_2.jpg" alt="..."></figure>
    <figure class="project-figure wide"><img src="image/Art/Logo/logo 4.jpg" alt="..."></figure>
    <figure class="project-figure wide"><img src="image/Art/Logo/logo 5.jpg" alt="..."></figure>
    <figure class="project-figure wide"><img src="image/Art/Logo/logo-image.jpg" alt="..."></figure>
</ProjectLayout>
