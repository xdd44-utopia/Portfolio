---
import ProjectLayout from '../../layouts/ProjectLayout.astro';

const page = {
    "title": "Feral | xdd44's Collections",
    "description": "Feral: A physical AI companion",
    "image": "https://xdd44.xyz/image/Art/Feral/cover.jpg",
    "heading": "Feral - Physical AI Companion",
    "cover": "image/Art/Feral/cover.jpg",
    "category": "Design",
    "year": "2026",
    "tags": [
        "Product Design",
        "Fabrication",
        "AI Agent"
    ]
};
---

<ProjectLayout {...page}>
    <p>Track winner of <a href="https://www.media.mit.edu/events/2026-hard-mode/" target="_blank">2026 MIT Hardmode AI Hackathon</a>, exhibited at Code with Claude event, San Francisco May 2026</p>
    <p><strong>Team members:</strong> Mateo, <strong>xdd</strong>, Kevin</p>
    <p>Visit <a href="https://ferine.studio/" target="_blank">project website</a> for more details about the follow up commercial product!</p>
    <figure class="project-figure wide"><img src="image/Art/Feral/live.jpg" alt="Event photo"><figcaption>Exhibited at Code with Claude event</figcaption></figure>
    <figure class="project-figure wide"><img src="image/Art/Feral/feral.gif" alt="Preliminary Simulation + Sealing"><figcaption>Hackathon Prototype</figcaption></figure>
    <figure class="project-figure wide"><img src="image/Art/Feral/photo.jpg" alt="Preliminary Simulation + Sealing"><figcaption>Hackathon Prototype</figcaption></figure>
    <figure class="project-figure wide"><img src="image/Art/Feral/matrix.jpg" alt="Preliminary Simulation + Sealing"><figcaption>Electromagnet matrix</figcaption></figure>
    <figure class="project-figure portrait" style="display:flex; flex-direction:column; align-items:center;">
        <blockquote class="instagram-media" data-instgrm-permalink="https://www.instagram.com/reel/DVt7lGyiQ3i/?utm_source=ig_embed&amp;utm_campaign=loading" data-instgrm-version="14" style="border:0; margin:0; max-width:400px; width:100%;"></blockquote>
        <script is:inline async src="https://www.instagram.com/embed.js"></script>
        <figcaption>Promotion Reel</figcaption>
    </figure>
</ProjectLayout>
