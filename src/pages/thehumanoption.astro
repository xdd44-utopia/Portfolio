---
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || (import.meta.env.DEV ? '1x00000000000000000000AA' : '');
---

<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#191919" />
    <meta name="description" content="The Human Option chat." />
    <title>The Human Option</title>
    <link rel="stylesheet" href="/css/thehumanoption.css" />
    <link rel="stylesheet" href="/css/thehumanoption_mobile.css" media="screen and (max-width: 450px)" />
</head>
<body>
    <main id="Main" class="human-option" data-site-key={siteKey}>
        <header class="chat-heading">
            <h1>The Human Option</h1>
            <button type="button" id="chat-reset" disabled>
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5H5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-7M16 3l5 5M10 14l-1 4 4-1L22 8a2.1 2.1 0 0 0-5-5Z" /></svg>
                <span>New chat</span>
            </button>
        </header>
        <dialog id="chat-access" aria-labelledby="chat-access-title">
            <form id="chat-access-form" autocomplete="off">
                <h2 id="chat-access-title">Private access</h2>
                <label for="chat-access-key">Access key</label>
                <input id="chat-access-key" type="password" required autocomplete="off" spellcheck="false" aria-describedby="chat-access-status" />
                <p id="chat-access-status" role="status"></p>
                <div class="chat-access-actions">
                    <button type="button" id="chat-access-cancel">Cancel</button>
                    <button type="submit">Unlock</button>
                </div>
            </form>
        </dialog>
        <section class="chat" aria-label="Conversation">
            <div class="chat-stage">
                <div id="chat-messages" role="log" aria-label="Messages" aria-live="polite" aria-relevant="additions" tabindex="0"></div>
            </div>
            <div class="chat-composer">
                <div class="chat-feedback">
                    <p id="chat-status" role="status" aria-live="polite">Connecting…</p>
                    <button type="button" id="chat-retry" hidden>Try again</button>
                </div>
                <div id="chat-verification"></div>
                <p id="chat-last-message" role="status" hidden>One message left in this chat</p>
                <form id="chat-form">
                    <label for="chat-message" class="visually-hidden">Your message</label>
                    <textarea id="chat-message" name="message" rows="1" maxlength="2000" placeholder="Message" required disabled aria-describedby="chat-hint"></textarea>
                    <p id="chat-hint" class="visually-hidden">Enter to send. Shift + Enter for a new line.</p>
                    <button type="submit" id="chat-send" aria-label="Send message" title="Send message" disabled>
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5m-6 6 6-6 6 6" /></svg>
                    </button>
                </form>
                <div class="chat-bottom">
                    <p class="chat-note">Closing this page ends the conversation here.</p>
                    <p id="chat-remaining"></p>
                </div>
                <noscript><p>Enable JavaScript to use chat.</p></noscript>
            </div>
        </section>
    </main>
    <script src="../scripts/thehumanoption.js"></script>
</body>
</html>
