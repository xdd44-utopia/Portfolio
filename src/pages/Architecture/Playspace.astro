---
import ProjectLayout from '../../layouts/ProjectLayout.astro';

const page = {
    "title": "Intergenerational Play Space Design Competition | xdd44's Collections",
    "description": "A group design proposal upgrading the Prosperous Garden public space with inclusive, multi-generational play facilities and AR experiences.",
    "image": "https://xdd44.xyz/image/Architecture/Playspace/1.jpg",
    "heading": "Intergenerational Play Space Design Competition",
    "cover": "image/Architecture/Playspace/1.jpg",
    "category": "Architecture",
    "year": "2021",
    "tags": [
        "Group Project",
        "Urban Design",
        "CityU HK"
    ]
};
---

<ProjectLayout {...page}>
    <p>Group project (Members: Ya WEN, Yuru XIE, Li FENG, Chenyue DAI, Ngakin WONG)</p>
    <p>An upgraded design of the Prosperous Garden Public Space.</p>

    <figure class="project-figure wide"><img src="image/Architecture/Playspace/I Site analysis.jpg" alt="Site Analysis"></figure>
    <figure class="project-figure wide"><img src="image/Architecture/Playspace/II Inspiration.jpg" alt="Inspiration"></figure>
    <figure class="project-figure wide"><img src="image/Architecture/Playspace/III Spatial design.jpg" alt="Spatial Design"></figure>
    <figure class="project-figure wide"><img src="image/Architecture/Playspace/IV Physical facilities.jpg" alt="Physical Facilities"></figure>
    <figure class="project-figure wide"><img src="image/Architecture/Playspace/V AR.jpg" alt="AR"></figure>
</ProjectLayout>
